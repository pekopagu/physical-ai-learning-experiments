<mujoco model="vision_target_tracking">
  <option timestep="0.002" gravity="0 0 0"/>

  <visual>
    <global offwidth="640" offheight="640"/>
  </visual>

  <worldbody>
    <light name="main_light" pos="0 0.4 3" diffuse="1 1 1" ambient="0.25 0.25 0.25"/>
    <geom name="floor" type="plane" size="2 2 0.1" rgba="0.15 0.15 0.15 1"/>

    <body name="base" pos="0 0 0.05">
      <geom type="cylinder" size="0.09 0.05" rgba="0.3 0.3 0.3 1" contype="0" conaffinity="0"/>
      <body name="link1" pos="0 0 0.05">
        <joint name="shoulder" type="hinge" axis="0 0 1" range="-180 180" damping="1"/>
        <geom type="capsule" fromto="0 0 0 0.6 0 0" size="0.045" rgba="0.2 0.5 0.9 1" contype="0" conaffinity="0"/>
        <body name="link2" pos="0.6 0 0">
          <joint name="elbow" type="hinge" axis="0 0 1" range="-180 180" damping="1"/>
          <geom type="capsule" fromto="0 0 0 0.45 0 0" size="0.04" rgba="0.2 0.8 0.5 1" contype="0" conaffinity="0"/>
          <site name="end_effector" pos="0.45 0 0" size="0.055" rgba="1 0.8 0 1"/>
        </body>
      </body>
    </body>

    <site name="target" pos="0.65 0.55 0.10" size="0.07" rgba="1 0.1 0.1 1"/>

    <geom name="distractor_box" type="box" pos="0 0 -1" size="0.06 0.04 0.03" rgba="0.8 0.2 0.1 0" contype="0" conaffinity="0"/>
    <geom name="distractor_capsule" type="capsule" pos="0 0 -1" size="0.04 0.06" rgba="0.8 0.2 0.1 0" contype="0" conaffinity="0"/>
    <geom name="distractor_ellipsoid" type="ellipsoid" pos="0 0 -1" size="0.07 0.04 0.03" rgba="0.8 0.2 0.1 0" contype="0" conaffinity="0"/>
    <geom name="ood_cylinder" type="cylinder" pos="0 0 -1" size="0.05 0.03" rgba="0.6 0.2 0.2 0" contype="0" conaffinity="0"/>
    <geom name="occluder" type="box" pos="0 0 -1" size="0.03 0.02 0.02" rgba="0.1 0.6 0.8 0" contype="0" conaffinity="0"/>

    <camera name="vision" pos="0 0.45 2.5" xyaxes="1 0 0 0 1 0" projection="orthographic" fovy="2.30"/>
  </worldbody>

  <actuator>
    <position name="shoulder_position" joint="shoulder" kp="80" kv="8" ctrlrange="-3.1416 3.1416"/>
    <position name="elbow_position" joint="elbow" kp="60" kv="6" ctrlrange="-3.1416 3.1416"/>
  </actuator>
</mujoco>
